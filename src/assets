<no-data icon="'https://assets.scocu.net/3830375668925515'" rv-if="rv.showLoading | not | and rv.products | prop 'length' | eq 0" text="'No Items Found'"></no-data> <script>
      if (!window.rv) window.rv = {};
      var storeDetails = window.libAuth.store;

      var productBadges = storeDetails.product_badges || [];
      rv.storeTypesData = storeDetails.store_type_json_data;
      [
        "show_products_add_to_cart",
        "show_products_description",
        "show_products_price",
        "show_products_price_after_login",
      ].forEach((prop) => {
        if (!rv.storeTypesData.hasOwnProperty(prop)) rv.storeTypesData[prop] = true;
      });
      rv.currentCategory = storeDetails.currentCategory;
      rv.showPrice = rv.storeTypesData.show_products_price;
      rv.showPlus = rv.storeTypesData.show_products_add_to_cart;
      rv.defaultImage = storeDetails.default_product_icon;
      rv.showDiets = storeDetails.settings.is_enable_daietry_attribute;
      rv.showViewPriceAfterLoginButton = false;
      rv.activeDiet = "";
      if (
        rv.storeTypesData.show_products_price_after_login &&
        !storeDetails.current_user
      ) {
        rv.showPrice = false;
        rv.showPlus = false;
      }
      if (rv.storeTypesData.show_products_price_after_login && !rv.showPrice)
        rv.showViewPriceAfterLoginButton = true;
      rv.imageBaseUrl = storeDetails.image_base_url;
      rv.showLoading = false;
      rv.products = [];

      rv.viewProduct = (e, model) => {
        e.stopImmediatePropagation();
        window.sendData({
          type: "openView",
          name: "procuct-quick-view",
          data: model.product,
        });
      };

      function filterByDiet(type) {
        rv.activeDiet = type;
        rv.products.map(p => p.hidden = p.type != type);
      }

      function clearDiet() {
        rv.activeDiet = "";
        rv.products.map(p => p.hidden = false);
      }

      rv.addToCart = (e, model) => {
        if (!model.product.is_single_variant || model.product.modifier?.modifiers.length > 0)
          return;
        e.stopImmediatePropagation();
        const product = JSON.parse(JSON.stringify(model.product));
        product.product_id = product.id;
        if (!product.variant_ids || product.variant_ids.length == 0) {
          toastr.error("Missing variant_id");
          return;
        }
        product.id = product.variant_ids[0];
        product.quantity = 1;
        if (storeDetails.tax_rates)
          product.tax =
            (
              storeDetails.tax_rates.find(
                (r) => r.tax_category_id == product.tax_category_id
              ) || {}
            ).amount || 0;
        window.sendData({ type: "setCartItem", item: product, operation: "plus" });
        setCartCountToProducts();
      };

      function setCartCountToProducts() {
        rv.products.forEach((p) => {
          const cartItem = (window.cartItems || []).find(
            (c) => c.id == p.variant_id
          );
          p.cart_count = cartItem ? cartItem.quantity : 0;
        });
      }

      function getPCartItem(id) {
        return (window.cartItems || []).find((c) => c.id == id);
      }

      rv.pCartIncrease = (e, model) => {
        e.stopImmediatePropagation();
        window.sendData({
          type: "setCartItem",
          item: getPCartItem(model.product.variant_id),
          operation: "plus",
          isFromCart: true,
        });
        setCartCountToProducts();
      };

      rv.pCartDecrease = (e, model) => {
        e.stopImmediatePropagation();
        if (model.product.cart_count == 1)
          window.sendData({
            type: "removeCartItem",
            item: getPCartItem(model.product.variant_id),
          });
        else
          window.sendData({
            type: "setCartItem",
            item: getPCartItem(model.product.variant_id),
            operation: "minus",
          });
        setCartCountToProducts();
      };

      rv.viewProductDetails = (e, model) => {
        if (!rv.showPrice) return;
        window.sendData({
          type: "navigate",
          path: "productDetails",
          id: model.product.id,
          data: model.product,
        });
      };

      function setProducts(data) {
        rv.currentCategory = storeDetails.currentCategory;
        data.forEach((d) => {
          d.images = [];
          if (d.files) {
            d.files = typeof d.files == "string" ? JSON.parse(d.files) : d.files;
            d.files.forEach((f) => {
              if (!f.file_url && f.file_id)
                f.file_url = "https://assets.growith.io/images/" + f.file_id;
              else if (f.file_url)
                f.file_url = f.file_url.replace(
                  "https://venus-scocu-assets.s3.amazonaws.com/",
                  rv.imageBaseUrl
                );
            });
            d.images = d.files.map((f) => f.file_url);
          }
          d.image = d.images[0] ? d.images[0] : "";
        });
        rv.products = data;
        rv.products.forEach((p) => {
          p.badges = productBadges
            .filter((b) => p[b.name])
            .map((b) => b.display_label);
          p.variant_id = p.variant_ids ? p.variant_ids[0] : null;
          p.cart_count = 0;
          if (storeDetails.brand) {
            p.name = storeDetails.brand.settings?.item_and_price_configuration?.item_name == 'pos' ? p.pos_name : p.name;
            p.description = storeDetails.brand.settings?.item_and_price_configuration?.item_description == 'pos' ? p.pos_description : p.description;
            p.price = storeDetails.brand.settings?.item_and_price_configuration?.price_configuration_type == 'base' && storeDetails.brand.settings?.item_and_price_configuration?.base_price == 'pos' ? p.pos_price != null && p.pos_price != undefined ? p.pos_price : p.price : p.price;
          }
          p.is_veg = p.dietary_attributes.includes('Veg');
          p.is_vegan = p.dietary_attributes.includes('Vegan');
          p.is_glutten_free = p.dietary_attributes.includes('Gluten Free');
          p.is_customizable = p.modifier && p.modifier.modifiers && p.modifier.modifiers.length ? true : false;
        });
        setCartCountToProducts();
        if (storeDetails.searchText) blinkProduct();
      }

      rv.setDefaultImage = (event, model) => {
        console.log(
          "Setting Default Image: ",
          model.product.name,
          " - ",
          model.product.image
        );
        model.product.image = "";
      };

      function gotoLogin() {
        window.sendData({ type: "navigate", path: "login" });
      }

      function blinkProduct() {
        setTimeout(() => {
          const product = rv.products.find(
            (p) => p.name == storeDetails.searchText
          );
          if (product) {
            const el = document.getElementById(product.id);
            el.classList.add("blink");
            setTimeout(() => {
              el.classList.remove("blink");
            }, 3500);
          }
        }, 500);
      }
      window.bindRivets(document.currentScript);
    </script></div>
</div>
 